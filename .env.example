# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
VALO_SECRET_KEY=

# Initial user, created on first start only if no user exists.
VALO_ADMIN_USERNAME=santi
VALO_ADMIN_PASSWORD=

# Set true when served over HTTPS (reverse proxy / Tailscale cert).
VALO_COOKIE_SECURE=false
VALO_PORT=8080
