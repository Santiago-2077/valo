# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
VALO_SECRET_KEY=

# Initial user, created on first start only if no user exists.
VALO_ADMIN_USERNAME=santi
VALO_ADMIN_PASSWORD=

# true when served over HTTPS (tailscale serve / reverse proxy): the session cookie is HTTPS-only.
VALO_COOKIE_SECURE=true
VALO_PORT=8080
# 127.0.0.1 = only reachable through tailscale serve (recommended). 0.0.0.0 = whole LAN over plain HTTP.
VALO_BIND=127.0.0.1
# Timezone used for "today", billing cycles and the daily job.
VALO_TIMEZONE=America/Mexico_City
